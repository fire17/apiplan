<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Relays the Mac's refreshed Codex ACCESS token (never the refresh token) to srv2 whenever ~/.codex/auth.json's
     last_refresh changes. See scripts/codex-relay.py.
     Install:   cp scripts/com.fire17.apiplan-codex-relay.plist ~/Library/LaunchAgents/
                launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.fire17.apiplan-codex-relay.plist
     Run now:   launchctl kickstart gui/$(id -u)/com.fire17.apiplan-codex-relay
     Status:    python3 scripts/codex-relay.py --status
     Remove:    launchctl bootout gui/$(id -u)/com.fire17.apiplan-codex-relay && rm ~/Library/LaunchAgents/com.fire17.apiplan-codex-relay.plist
     A plist edit needs bootout + bootstrap (kickstart reuses the cached job). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fire17.apiplan-codex-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/magic/Creations/APIPlan/scripts/codex-relay.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/magic/Creations/APIPlan</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/magic/.bun/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/magic</string>
  </dict>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/magic/.livemind/codex-relay.log</string>
  <key>StandardErrorPath</key><string>/Users/magic/.livemind/codex-relay.log</string>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
